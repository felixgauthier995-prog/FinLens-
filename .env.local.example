# Sanity project connection — find these in your project at sanity.io/manage.
# Neither value is secret; they're safe to share/commit as an example.
# Kept for the embedded Studio (/studio); News/Agenda now read from
# Supabase instead, see below.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed once, to run `npm run seed` (pushes the built-in mock content
# into Sanity so the Studio isn't empty on first login). Generate at
# sanity.io/manage → your project → API → Tokens (Editor permission).
# Keep this one secret — do not commit it.
SANITY_WRITE_TOKEN=

# Supabase project connection — Project Settings → Data API in your
# Supabase dashboard. The URL and anon key are not secret (safe in the
# browser bundle, protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — bypasses Row Level Security entirely. Server-only, used by the
# /api/cron/* ingestion routes. Project Settings → API Keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Financial Modeling Prep API key (site.financialmodelingprep.com) — powers
# the real earnings calendar (Agenda) and live asset prices.
FMP_API_KEY=

# Shared secret the /api/cron/* routes require in an
# `Authorization: Bearer <value>` header, so only your own scheduler can
# trigger them. Generate any random string, e.g. `openssl rand -hex 24`.
CRON_SECRET=
